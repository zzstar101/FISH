# 复制后使用：cp .env.example .env
# 仅本地开发占位值，禁止提交任何真实密钥。

DATABASE_URL=postgres://fish:fish@localhost:5432/fish

API_PORT=3000
# 仅在 API 位于 Caddy 等反代后时设置为其 TCP 来源地址；匿名编号查询及扫码建票限流只信该代理覆盖的 X-Real-IP。
# LISTING_LOOKUP_TRUSTED_PROXY_IP=127.0.0.1
# 浏览器端唯一入口是 PC Web（`bun run dev:web-pc`，http://localhost:5174）；生产为站点根域名。
WEB_ORIGIN=http://localhost:5174

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=fish
S3_SECRET_ACCESS_KEY=fish-secret
S3_BUCKET=fish
S3_PUBLIC_URL=http://localhost:9000/fish
# 腾讯云 COS 只接受虚拟主机风格：设为 true，且 S3_ENDPOINT 写桶域名本身（见 docs/deployment.md）。
# S3_VIRTUAL_HOSTED_STYLE=false

# #68 校园认证：必须显式选择 transport；本地开发写 outbox，不会发送真实邮件。
MAIL_TRANSPORT=outbox
# 相对路径以 API 工作目录 apps/api 为基准；outbox 含验证码，不进日志或 Git。
# MAIL_OUTBOX_PATH=.dev/mail-outbox.jsonl

# 生产必须改为 smtp 或 resend；缺配置时 API 启动失败。NODE_ENV 不决定邮件投递方式。
# smtp（生产用飞书企业邮箱）：SMTP_PORT 默认 465，SMTP_SECURE 默认 true（隐式 TLS，不支持 STARTTLS）；
# SMTP_SECURE=false 是明文，只允许 SMTP_HOST 为回环地址（本机测试），否则启动失败。
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.feishu.cn
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@example.com
# SMTP_PASS=REPLACE_ME_SMTP_PASSWORD
# SMTP_FROM="鱼小应 <noreply@example.com>"
# resend：需配置已在 Resend 验证域名的发件人。
# MAIL_TRANSPORT=resend
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM="鱼小应 <noreply@example.edu.cn>"

# #70 面交交易码的 HMAC 签名密钥（仅本地开发占位值）。生产必须更换并妥善保管。
# API 专属（worker 不做 HMAC），不少于 32 字符，缺失/过短时 API 启动失败。
# 泄漏等同数据库泄漏：可离线伪造任意面交码。
MEETUP_TOKEN_SECRET=dev-only-meetup-secret-0123456789abcdef

# #141 商品描述 AI 润色：transport 无默认值，缺失即 API 启动失败（worker 不读这四个变量）。
# 本地开发先用 stub——真 HTTP 的假模型服务，不出网、不需要任何密钥，另开一个终端跑：
#   bun apps/api/scripts/ai-polish-stub.ts
AI_POLISH_TRANSPORT=stub
AI_POLISH_BASE_URL=http://127.0.0.1:8787

# 切到 live（OpenAI 兼容托管端点）时三项必须齐全，缺一项即启动失败。
# 真实 key 只留在本机 .env 与部署机的 API 专属密钥文件，绝不入仓、不入日志。
# AI_POLISH_TRANSPORT=live
# AI_POLISH_BASE_URL=https://api.deepseek.com
# AI_POLISH_API_KEY=
# AI_POLISH_MODEL=deepseek-flash

# #86 微信身份（API 专属）：transport 无默认值，缺失即 API 启动失败（不静默回退 stub）。
# off = 微信登录 / 手机号绑定入口关闭（503 WECHAT_DISABLED）——拿到 AppSecret 前的生产安全态。
WECHAT_TRANSPORT=off
# stub = 只允许本地开发/测试显式开启（不验证微信签发的凭证）；NODE_ENV=production 下直接启动失败。
# WECHAT_TRANSPORT=stub
# live = 真实 jscode2session / phonenumber.getPhoneNumber，两项必须齐全，缺一启动失败。
# WECHAT_TRANSPORT=live
# WECHAT_APPID=
# WECHAT_APP_SECRET=

# #197 扫码登录出码的小程序版本，缺省 release。release 要求小程序**已发布**
# （官方：「接口只能生成已发布的小程序的二维码」）；trial / develop 用于发版前联调。
# WECHAT_QR_ENV_VERSION=release

# #462 微信订阅消息（API 专属，全部可选）：三个模板 ID 都取自「微信公众平台 →
# 功能 → 订阅消息」的 **priTmplId**（43 位），不是模板标题。留空 = 该 kind 未开通。
# 三条同时成立才会真的推送：WECHAT_TRANSPORT=live、对应变量非空、用户在端上「允许」过。
# 任一项不满足时整个功能关闭：`GET /subscribe-messages/config` 下发的模板 ID 为 null，
# 端上据此**不弹授权框**，写接口返回 503 SUBSCRIBE_MESSAGES_DISABLED。
# 发送用的 miniprogram_state 由上面的 WECHAT_QR_ENV_VERSION 映射（release→formal）。
# 下面是正式 AppID（wx61b67a115826647e）下已申请到的三个模板，作示例值：
# WECHAT_SUBSCRIBE_TMPL_CHAT=dfuovKQoKXQJzo5t3ayKnQvW1ZunS8pwB7X0ZoZzzF8
# WECHAT_SUBSCRIBE_TMPL_TX=31NYOZH2qjoGUp93gRTy3RhOON5fW_RxoOgVHyUex4M
# WECHAT_SUBSCRIBE_TMPL_REVIEW=mskwaeWwNkJnu9_qG_7sBrh50Qe2pvr5URzQa2vgfVo

# #228 内容安全审核（API 专属）：transport 无默认值，缺失即 API 启动失败（不静默回退）。
# local = 只允许本地开发/测试：文本走本地词表，图片不做内容审核（一律进人工队列、不公开）。
# NODE_ENV=production 下用 local 直接启动失败——本地词表不是内容安全审核。
CONTENT_MODERATION_TRANSPORT=local

# tencent = 生产用腾讯云 TMS（文本）/ IMS（图片），四项必须齐全，缺一启动失败。
# SecretId/SecretKey 属密钥：只留在本机 .env 与部署机的 API 专属密钥文件，绝不入仓、不入日志、不下发客户端。
# BizType 是腾讯控制台上按业务创建的策略号（文本、图片各一个）。
# CONTENT_MODERATION_TRANSPORT=tencent
# TENCENT_CLOUD_SECRET_ID=
# TENCENT_CLOUD_SECRET_KEY=
# TENCENT_TMS_BIZ_TYPE=
# TENCENT_IMS_BIZ_TYPE=
# 可选，默认 ap-guangzhou。
# TENCENT_CLOUD_REGION=ap-guangzhou

# #322 M1 语义向量：worker 写向量；#524 起 API 也读 EMBEDDING_TRANSPORT / EMBEDDING_MODEL（只读模型名，
# 按它过滤推荐召回与兴趣画像，不读 BASE_URL / API_KEY）。transport 无默认值，缺失即 worker 与 API 启动失败；
# live 时 API 缺 EMBEDDING_MODEL 同样启动失败。两个进程必须读到同一个 EMBEDDING_MODEL。
# stub = 进程内确定性实现（同一文本永远同一向量，共享词元相似度为正），不出网、不需要密钥；
# 只允许本地开发/测试显式开启，NODE_ENV=production 下直接启动失败（假向量会产出看似合理的召回）。
EMBEDDING_TRANSPORT=stub

# live = OpenAI 兼容的 /embeddings 端点，三项必须齐全，缺一即启动失败。
# EMBEDDING_MODEL 会原样写入 embeddings.model：换模型必须显式改这里，读侧按 model 过滤，
# 不会静默混用不同模型的向量。真实 key 只留在本机 .env 与部署机的 worker 专属密钥文件，绝不入仓、不入日志。
# EMBEDDING_TRANSPORT=live
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

# #324 拍照识图搜索的视觉向量化（API + worker 共用）：transport 无默认值，缺失即启动失败。
# stub = 进程内确定性实现（同一图片字节永远同一向量），不出网、不需要密钥；
# 只允许本地开发/测试显式开启，NODE_ENV=production 下直接启动失败。
# 注意：stub 与 live 的向量**不可混用**（不同模型 = 不同向量空间），换 transport 必须重跑回填。
VISUAL_EMBEDDING_TRANSPORT=stub

# live = 阿里云百炼多模态向量化。多模态接口不支持 OpenAI 兼容协议，必须走 DashScope 原生
# `/services/embeddings/multimodal-embedding/multimodal-embedding`，三项必须齐全，缺一即启动失败。
# `VISUAL_EMBEDDING_MODEL` 会原样写入 `listing_visual_embeddings.model` 并按它过滤召回。
# 数据出域：图片以 Base64 data URI 形式发给上游（私有对象存储的地址上游取不到），
# 即查询图与商品封面字节都会离开本服务，保留策略见 PR 描述。
# VISUAL_EMBEDDING_TRANSPORT=live
# VISUAL_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# VISUAL_EMBEDDING_API_KEY=
# VISUAL_EMBEDDING_MODEL=qwen3-vl-embedding

# #324 M5 查询图语义解析（OCR/VLM，API 专属）：未设置即 off——只做图片向量召回，
# 不产生第二次上游调用，也就不会把查询图再发一次。开启后文本路才参与召回（失败一律降级）。
# off = 默认，不解析。
# VISUAL_PARSE_TRANSPORT=live
# VISUAL_PARSE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISUAL_PARSE_API_KEY=
# VISUAL_PARSE_MODEL=qwen3-vl-plus
# #584 主体框也由这次解析给出：off 时不框主体、按整图检索。主体框坐标按 Qwen3-VL 的
# 0–1000 归一化约定解读；换成坐标约定不同的模型（如 Qwen2.5-VL 回绝对像素）框会错。
