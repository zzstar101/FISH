# 复制后使用：cp .env.example .env
# 仅本地开发占位值，禁止提交任何真实密钥。

DATABASE_URL=postgres://fish:fish@localhost:5432/fish

API_PORT=3000
WEB_ORIGIN=http://localhost:5173

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=fish
S3_SECRET_ACCESS_KEY=fish-secret
S3_BUCKET=fish
S3_PUBLIC_URL=http://localhost:9000/fish

# #68 校园认证：dev 验证码邮件写到此文件（不进日志）；留空用默认 .dev/mail-outbox.jsonl
# MAIL_OUTBOX_PATH=.dev/mail-outbox.jsonl

# #68 邮件投递环境：production 必须配齐 RESEND_API_KEY + RESEND_FROM，否则 API 启动失败；
# development / test 走本地 dev outbox，不需要这两项。
# NODE_ENV=production
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM="鱼小应 <noreply@example.edu.cn>"
