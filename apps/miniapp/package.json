{
  "name": "@fish/miniapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FISH 微信小程序客户端（Taro 4 + React + TypeScript）",
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp && bun run check:es5",
    "check:es5": "bun scripts/check-es5.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@fish/contracts": "workspace:*",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-react": "^7.24.1",
    "@tarojs/cli": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "acorn": "^8.18.0",
    "babel-preset-taro": "4.2.1",
    "postcss": "^8.5.6",
    "sass": "^1.75.0",
    "webpack": "5.91.0"
  }
}
