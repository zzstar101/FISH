{
  "name": "fish",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@fish/*' dev",
    "dev:web-pc": "bun run --filter '@fish/web-pc' dev",
    "dev:api": "bun run --filter '@fish/api' dev",
    "dev:worker": "bun run --filter '@fish/worker' dev",
    "dev:miniapp": "bun run --filter '@fish/miniapp' dev:weapp",
    "build": "bun run --filter '@fish/*' build",
    "build:web-pc": "bun run --filter '@fish/web-pc' build",
    "build:miniapp": "bun run --filter '@fish/miniapp' build:weapp",
    "typecheck": "bun run --filter '@fish/*' typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test --isolate",
    "ws:smoke": "bun run scripts/ws-smoke.ts",
    "core:smoke": "bun run apps/api/scripts/core-smoke.ts",
    "rank:compare": "bun run apps/worker/scripts/rank-compare.ts",
    "rank:eval": "bun run apps/worker/scripts/rank-eval.ts",
    "recommendation:cleanup": "bun run apps/worker/scripts/recommendation-cleanup.ts",
    "visual:backfill": "bun run apps/worker/scripts/visual-backfill.ts",
    "visual:eval": "bun run apps/api/scripts/visual-eval.ts",
    "visual:eval:db": "bun run apps/api/scripts/visual-eval-db.ts",
    "embed:backfill": "bun run apps/worker/scripts/backfill-embeddings.ts",
    "embed:eval": "bun run apps/worker/scripts/embed-eval.ts",
    "embed:holdout": "bun run apps/worker/scripts/embed-holdout.ts",
    "obs:summary": "bun run apps/worker/scripts/obs-summary.ts",
    "ann:probe": "bun run apps/worker/scripts/ann-probe.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "bun run --filter '@fish/db' generate",
    "db:migrate": "bun run --filter '@fish/db' migrate",
    "db:seed": "bun run --filter '@fish/db' seed",
    "db:promote": "bun run --filter '@fish/db' promote",
    "db:studio": "bun run --filter '@fish/db' studio",
    "db:dev": "bun run scripts/dev-db.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
